# Public frontend URL used for redirects and password-reset links.
APP_URL="http://localhost:3000"

# SQLite path. Defaults to server/data/studysync.db.
STUDYSYNC_DB_PATH="server/data/studysync.db"

# PostgreSQL operations and staging migration target. The current local API
# remains SQLite-backed until the persistence-adapter cutover is complete.
DATABASE_URL=""
BACKUP_DIR="backups"
LOG_LEVEL="info"

# Production-only webhook that accepts JSON: { "email": "...", "resetUrl": "..." }.
PASSWORD_RESET_DELIVERY_URL=""
PASSWORD_RESET_DELIVERY_TOKEN=""
